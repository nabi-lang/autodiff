//! Derivatives of whole functions: the mode follows the number type the
//! function is written over. `Dual`: one evaluation per input; `Duals<N>`:
//! one per `N` inputs; `Var`: one evaluation and one backward sweep per
//! output; `HyperDual`: Hessians; `Jet`: derivatives of any order.

use pkg::lanes::seed_lanes;
use pkg::{Dual, Duals, HyperDual, Jet, Tape, Var};
use core::array::{Array, Matrix, Vector};
use linalg::AsVector;

/// `x` as dual numbers with the derivative part of element `k` set to 1,
/// the others 0 (`k >= x.len()` seeds none).
///
/// ```nabi
/// use core::array::Vector;
///
/// let x: Vector<f64> = [1.0, 2.0];
/// assert(autodiff::seed(x, 1)[1].du == 1.0 && autodiff::seed(x, 1)[0].du == 0.0);
/// ```
pub fn seed(x: Vector<f64>, k: usize) -> Vector<Dual> {
    let n = x.len();
    let xs: List<Dual> = List::with_capacity(n);
    for i in 0..n { xs.push(Dual { re: x[i], du: if i == k { 1.0 } else { 0.0 } }); }
    Array::view_list(xs, [n])
}

/// A function `R^n -> R` written over an AD number: what `grad` and
/// `value_grad` take. `fn(Vector<Dual>) -> Dual` costs `n` evaluations,
/// `fn(Vector<Duals<N>>) -> Duals<N>` (N = 2, 4, 8 or 16) costs `ceil(n / N)`, and
/// `fn(Vector<Var>) -> Var` one evaluation and one backward sweep
/// (reverse mode: the choice for many inputs).
pub trait ScalarFn {
    /// The value and the gradient at `x`.
    fn value_grad_at(self, x: Vector<f64>) -> (f64, Vector<f64>);
}

impl ScalarFn for fn(Vector<Dual>) -> Dual {
    fn value_grad_at(self, x: Vector<f64>) -> (f64, Vector<f64>) {
        let n = x.len();
        let g: Vector<f64> = Array::zeros([n]);
        if n == 0 { return (self(seed(x, 0)).re, g); }
        let v = 0.0;
        for k in 0..n {
            let y = self(seed(x, k));
            g[k] = y.du;
            v = y.re;
        }
        (v, g)
    }
}

impl ScalarFn for fn(Vector<Var>) -> Var {
    fn value_grad_at(self, x: Vector<f64>) -> (f64, Vector<f64>) {
        let t = Tape::new();
        let xs = t.vars(x);
        let y = self(xs);
        (y.value(), y.backward().wrt_all(xs))
    }
}

/// A function `R^n -> R^m` written over an AD number: what `jacobian`
/// takes. `Dual` builds the Jacobian by columns (`n` evaluations),
/// `Duals<N>` by `N` columns at once, `Var` by rows (one evaluation, `m`
/// backward sweeps).
pub trait VectorFn {
    /// The value and the `m x n` Jacobian at `x`.
    fn value_jacobian_at(self, x: Vector<f64>) -> (Vector<f64>, Matrix<f64>);
}

impl VectorFn for fn(Vector<Dual>) -> Vector<Dual> {
    fn value_jacobian_at(self, x: Vector<f64>) -> (Vector<f64>, Matrix<f64>) {
        let n = x.len();
        let y0 = self(seed(x, 0));
        let m = y0.len();
        let v: Vector<f64> = Array::from_fn([m], |i: [usize; 1]| -> f64 { y0[i[0]].re });
        let j: Matrix<f64> = Array::zeros([m, n]);
        for k in 0..n {
            let c = if k == 0 { y0 } else { self(seed(x, k)) };
            for i in 0..m { j[i, k] = c[i].du; }
        }
        (v, j)
    }
}

impl VectorFn for fn(Vector<Var>) -> Vector<Var> {
    fn value_jacobian_at(self, x: Vector<f64>) -> (Vector<f64>, Matrix<f64>) {
        let n = x.len();
        let t = Tape::new();
        let xs = t.vars(x);
        let y = self(xs);
        let m = y.len();
        let v: Vector<f64> = Array::zeros([m]);
        let j: Matrix<f64> = Array::zeros([m, n]);
        for i in 0..m {
            v[i] = y[i].value();
            let d = y[i].backward();
            for k in 0..n { j[i, k] = d.wrt(xs[k]); }
        }
        (v, j)
    }
}

// One impl per lane count: a `const N` impl on a function type is not
// matched by the trait solver.
#[impl_macro(lanes)] @macro {
    (@rep[sep = ","] { @n: expr }) => {
        @for @n {
            impl ScalarFn for fn(Vector<Duals<@n>>) -> Duals<@n> {
                fn value_grad_at(self, x: Vector<f64>) -> (f64, Vector<f64>) {
                    let n = x.len();
                    let g: Vector<f64> = Array::zeros([n]);
                    let y0 = self(seed_lanes::<@n>(x, 0));
                    let k0 = 0usize;
                    while k0 < n {
                        let y = if k0 == 0 { y0 } else { self(seed_lanes::<@n>(x, k0)) };
                        for j in 0..(n - k0).min(@n) { g[k0 + j] = y.du[j]; }
                        k0 += @n;
                    }
                    (y0.re, g)
                }
            }

            impl VectorFn for fn(Vector<Duals<@n>>) -> Vector<Duals<@n>> {
                fn value_jacobian_at(self, x: Vector<f64>) -> (Vector<f64>, Matrix<f64>) {
                    let n = x.len();
                    let y0 = self(seed_lanes::<@n>(x, 0));
                    let m = y0.len();
                    let v: Vector<f64> = Array::from_fn([m], |i: [usize; 1]| -> f64 { y0[i[0]].re });
                    let j: Matrix<f64> = Array::zeros([m, n]);
                    let k0 = 0usize;
                    while k0 < n {
                        let c = if k0 == 0 { y0 } else { self(seed_lanes::<@n>(x, k0)) };
                        for i in 0..m {
                            for l in 0..(n - k0).min(@n) { j[i, k0 + l] = c[i].du[l]; }
                        }
                        k0 += @n;
                    }
                    (v, j)
                }
            }
        }
    }
}

lanes!(2, 4, 8, 16);

/// `f'(x)` by one evaluation of `f` at `x + ε`.
///
/// ```nabi
/// use autodiff::Dual;
///
/// let d = autodiff::derivative(|x: Dual| -> Dual { x.exp() * x }, 1.0);
/// assert(d.is_close(2.0 * 1.0f64.exp()));
/// ```
pub fn derivative(f: fn(Dual) -> Dual, x: f64) -> f64 { f(Dual::var(x)).du }

/// `f(x), f'(x), .., f^(n)(x)` by one Taylor-mode evaluation of `f` over
/// jets of order `n`, O(n^2) per operation.
///
/// ```nabi
/// use autodiff::Jet;
///
/// let d = autodiff::derivatives(|x: Jet| -> Jet { x.exp() * x }, 0.0, 3);
/// assert(d.to_list() == [0.0, 1.0, 2.0, 3.0]);      // (x + k) e^x at 0
/// ```
pub fn derivatives(f: fn(Jet) -> Jet, x: f64, n: usize) -> Vector<f64> { f(Jet::var(x, n)).derivatives() }

/// The value and gradient of `f: R^n -> R` at `x` (see `ScalarFn` for
/// the cost of each number type).
///
/// ```nabi
/// use autodiff::{Dual, Var};
/// use core::array::Vector;
///
/// let (v, g) = autodiff::value_grad(|x: Vector<Dual>| -> Dual { x[0] * x[1] + x[0].sin() }, [0.0, 3.0]);
/// assert(v == 0.0 && g[0] == 4.0 && g[1] == 0.0);
/// let (w, h) = autodiff::value_grad(|x: Vector<Var>| -> Var { x[0] * x[1] + x[0].sin() }, [0.0, 3.0]);
/// assert(w == v && h == g);
/// ```
pub fn value_grad<F: ScalarFn, X: AsVector<f64>>(f: F, x: X) -> (f64, Vector<f64>) {
    let v: Vector<f64> = x.as_vector();
    f.value_grad_at(v)
}

/// The gradient of `f: R^n -> R` at `x`.
///
/// ```nabi
/// use autodiff::{Duals, Var};
/// use core::array::Vector;
///
/// let g = autodiff::grad(|x: Vector<Var>| -> Var { x[0] ** 2 + 3.0 * x[1] }, [1.0, 2.0]);
/// assert(g[0] == 2.0 && g[1] == 3.0);
/// let h = autodiff::grad(|x: Vector<Duals<4>>| -> Duals<4> { x[0] ** 2 + 3.0 * x[1] }, [1.0, 2.0]);
/// assert(h == g);
/// ```
pub fn grad<F: ScalarFn, X: AsVector<f64>>(f: F, x: X) -> Vector<f64> {
    let v: Vector<f64> = x.as_vector();
    f.value_grad_at(v).1
}

/// The `m x n` Jacobian of `f: R^n -> R^m` at `x` (see `VectorFn`).
///
/// ```nabi
/// use autodiff::{Dual, Var};
/// use core::array::{Array, Vector};
///
/// let f = |x: Vector<Dual>| -> Vector<Dual> { Array::from([x[0] * x[1], x[0] + x[1]]) };
/// let j = autodiff::jacobian(f, [2.0, 5.0]);
/// assert(j[0, 0] == 5.0 && j[0, 1] == 2.0 && j[1, 1] == 1.0);
/// let r = |x: Vector<Var>| -> Vector<Var> { Array::from([x[0] * x[1], x[0] + x[1]]) };
/// assert(autodiff::jacobian(r, [2.0, 5.0]) == j);
/// ```
pub fn jacobian<F: VectorFn, X: AsVector<f64>>(f: F, x: X) -> Matrix<f64> {
    let v: Vector<f64> = x.as_vector();
    f.value_jacobian_at(v).1
}

/// The value and Jacobian of `f` at `x`.
pub fn value_jacobian<F: VectorFn, X: AsVector<f64>>(f: F, x: X) -> (Vector<f64>, Matrix<f64>) {
    let v: Vector<f64> = x.as_vector();
    f.value_jacobian_at(v)
}

/// The Jacobian-vector product `J(x) v` by one forward evaluation, the
/// directional derivative of `f` along `v`.
///
/// ```nabi
/// use autodiff::Dual;
/// use core::array::{Array, Vector};
///
/// let f = |x: Vector<Dual>| -> Vector<Dual> { Array::from([x[0] * x[1], x[0].sin()]) };
/// let u = autodiff::jvp(f, [2.0, 3.0], [1.0, 1.0]);
/// assert(u[0] == 5.0 && u[1] == 2.0f64.cos());
/// ```
pub fn jvp<X: AsVector<f64>, V: AsVector<f64>>(f: fn(Vector<Dual>) -> Vector<Dual>, x: X, v: V) -> Vector<f64> {
    let xv: Vector<f64> = x.as_vector();
    let vv: Vector<f64> = v.as_vector();
    let n = xv.len();
    let xs: List<Dual> = List::with_capacity(n);
    for i in 0..n { xs.push(Dual::new(xv[i], if i < vv.len() { vv[i] } else { 0.0 })); }
    let y = f(Array::view_list(xs, [n]));
    Array::from_fn([y.len()], |i: [usize; 1]| -> f64 { y[i[0]].du })
}

/// The vector-Jacobian product `w^T J(x)` by one evaluation and one
/// backward sweep: the gradient of `w . f`.
///
/// ```nabi
/// use autodiff::Var;
/// use core::array::{Array, Vector};
///
/// let f = |x: Vector<Var>| -> Vector<Var> { Array::from([x[0] * x[1], x[0].sin()]) };
/// let u = autodiff::vjp(f, [2.0, 3.0], [1.0, 0.0]);
/// assert(u[0] == 3.0 && u[1] == 2.0);
/// ```
pub fn vjp<X: AsVector<f64>, W: AsVector<f64>>(f: fn(Vector<Var>) -> Vector<Var>, x: X, w: W) -> Vector<f64> {
    let xv: Vector<f64> = x.as_vector();
    let wv: Vector<f64> = w.as_vector();
    let t = Tape::new();
    let xs = t.vars(xv);
    let y = f(xs);
    let s = Var::constant(0.0);
    for i in 0..y.len().min(wv.len()) { s = s + y[i].clone() * wv[i]; }
    s.backward().wrt_all(xs)
}

/// The Hessian of `f: R^n -> R` at `x` by hyper-dual numbers: entry
/// `(i, j)` from one evaluation seeded `ε1` in `x[i]` and `ε2` in `x[j]`,
/// `n (n + 1) / 2` evaluations, exact to rounding, symmetric.
///
/// ```nabi
/// use autodiff::HyperDual;
/// use core::array::Vector;
///
/// let h = autodiff::hessian(|x: Vector<HyperDual>| -> HyperDual { x[0] * x[0] * x[1] }, [3.0, 2.0]);
/// assert(h[0, 0] == 4.0 && h[0, 1] == 6.0 && h[1, 0] == 6.0 && h[1, 1] == 0.0);
/// ```
pub fn hessian<X: AsVector<f64>>(f: fn(Vector<HyperDual>) -> HyperDual, x: X) -> Matrix<f64> {
    let xv: Vector<f64> = x.as_vector();
    let n = xv.len();
    let h: Matrix<f64> = Array::zeros([n, n]);
    let xs: List<HyperDual> = List::from_fn(n, |i| HyperDual::constant(xv[i]));
    let v = Array::view_list(xs, [n]);
    for i in 0..n {
        for j in i..n {
            xs[i] = HyperDual::new(xv[i], 1.0, 0.0, 0.0);
            xs[j] = HyperDual::new(xv[j], if i == j { 1.0 } else { 0.0 }, 1.0, 0.0);
            let d = f(v).e12;
            xs[i] = HyperDual::constant(xv[i]);
            xs[j] = HyperDual::constant(xv[j]);
            h[i, j] = d;
            h[j, i] = d;
        }
    }
    h
}
