use pkg::ops::{∂, ∇};
use pkg::{Dual, HyperDual, Jet, Var};
use core::array::{Array, Matrix, Vector};

#[test]
fn derivative_functions() {
    let f = ∂(|x: Dual| -> Dual { x * x * x });
    assert(f(2.0) == 12.0);
    let g = ∂(|x: Var| -> Var { x.exp() });
    assert(g(0.0) == 1.0);
    let h2 = ∂(|x: HyperDual| -> HyperDual { x.sin() }, 2);
    assert(h2(1.0).is_close(-1.0f64.sin()));
    let j4 = ∂(|x: Jet| -> Jet { x.sin() }, 4);
    assert(j4(1.0).is_close(1.0f64.sin()));
    let x = 3.0 + 1.0ε;
    assert((x * x).du == 6.0 && (2.5ε).du == 2.5);
}

#[test]
fn gradient_functions() {
    let g = ∇(|x: Vector<Dual>| -> Dual { x[0] * x[1] });
    let r = ∇(|x: Vector<Var>| -> Var { x[0] * x[1] });
    let p: Vector<f64> = [2.0, 5.0];
    assert(g(p) == r(p) && r(p).to_list() == [5.0, 2.0]);
    let j = ∇(|x: Vector<Var>| -> Vector<Var> { Array::from([x[0] * x[1], x[0]]) });
    assert(j(p).shape() == [2, 2] && j(p)[0, 0] == 5.0 && j(p)[1, 1] == 0.0);
    let jd = ∇(|x: Vector<Dual>| -> Vector<Dual> { Array::from([x[0] * x[1], x[0]]) });
    assert(jd(p) == j(p));
}

#[test]
fn gradient_samples() {
    let y: Vector<f64> = [0, 1, 4, 9, 16];
    assert(∇(y).to_list() == [1.0, 2.0, 4.0, 6.0, 7.0]);
    let one: Vector<f64> = [3.0];
    assert(∇(one).to_list() == [0.0]);
    let empty: Vector<f64> = Array::zeros([0]);
    assert(∇(empty).len() == 0);
    let z = Matrix::<f64>::from_fn([3, 4], |i: [usize; 2]| -> f64 { (i[0] * i[0]) as f64 + 3.0 * i[1] as f64 });
    let g = ∇(z);
    assert(g.len() == 2 && g[0][1, 2] == 2.0 && g[0][0, 0] == 1.0 && g[1][2, 3] == 3.0);
    let c = Array::<f64, 3>::from_fn([2, 2, 3], |i: [usize; 3]| -> f64 { (i[0] + 2 * i[1] + 3 * i[2]) as f64 });
    let gc = ∇(c);
    assert(gc[0].all_close(Array::<f64, 3>::ones([2, 2, 3])) && gc[2][1, 1, 1] == 3.0);
}
