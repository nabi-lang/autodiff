use pkg::tests::suite::{mix, rand, rosen, rosen_grad};
use pkg::{Dual, Duals, Var};
use core::array::{Array, Matrix, Vector};

#[test]
fn gradients_agree() {
    for n in [2usize, 3, 7, 16, 33] {
        let x = rand(n, -1.5, 1.5, n as u64);
        let want = rosen_grad(x);
        let tol = 1e-12;
        assert(pkg::grad(rosen::<Dual>, x).all_close(want, rel: tol, abs: tol), f"dual {n}");
        assert(pkg::grad(rosen::<Var>, x).all_close(want, rel: tol, abs: tol), f"var {n}");
        assert(pkg::grad(rosen::<Duals<4>>, x).all_close(want, rel: tol, abs: tol), f"duals4 {n}");
        assert(pkg::grad(rosen::<Duals<8>>, x).all_close(want, rel: tol, abs: tol), f"duals8 {n}");
        let (v, _) = pkg::value_grad(rosen::<Var>, x);
        assert(v.is_close(rosen::<f64>(x)));
    }
}

#[test]
fn mixed_functions_agree() {
    let x: Vector<f64> = [0.4, -0.3, 0.8];
    let a = pkg::grad(mix::<Dual>, x);
    assert(pkg::grad(mix::<Var>, x).all_close(a, rel: 1e-13));
    assert(pkg::grad(mix::<Duals<2>>, x).all_close(a, rel: 1e-13));
    // Central differences agree to their own accuracy.
    for k in 0..3 {
        let h = 1e-6;
        let (p, m) = (x.clone(), x.clone());
        p[k] += h;
        m[k] -= h;
        let fd = (mix::<f64>(p) - mix::<f64>(m)) / (2.0 * h);
        assert(fd.is_close(a[k], rel: 1e-8, abs: 1e-9), f"fd {k}");
    }
}

fn vf(x: Vector<Dual>) -> Vector<Dual> { Array::from([x[0] * x[1].sin(), x[0].exp() + x[2], x[1] * x[2] * x[2]]) }
fn vr(x: Vector<Var>) -> Vector<Var> { Array::from([x[0] * x[1].sin(), x[0].exp() + x[2], x[1] * x[2] * x[2]]) }
fn vl(x: Vector<Duals<2>>) -> Vector<Duals<2>> { Array::from([x[0] * x[1].sin(), x[0].exp() + x[2], x[1] * x[2] * x[2]]) }

#[test]
fn jacobians_agree() {
    let x: Vector<f64> = [0.5, 1.2, -0.7];
    let want: Matrix<f64> = [[1.2f64.sin(), 0.5 * 1.2f64.cos(), 0.0], [0.5f64.exp(), 0.0, 1.0], [0.0, 0.49, 2.0 * 1.2 * -0.7]];
    assert(pkg::jacobian(vf, x).all_close(want, rel: 1e-14, abs: 1e-15));
    assert(pkg::jacobian(vr, x).all_close(want, rel: 1e-14, abs: 1e-15));
    assert(pkg::jacobian(vl, x).all_close(want, rel: 1e-14, abs: 1e-15));
    let (v, _) = pkg::value_jacobian(vr, x);
    assert(v[1] == 0.5f64.exp() - 0.7);
    // jvp = J v, vjp = w^T J.
    let dir: Vector<f64> = [1.0, -2.0, 0.5];
    assert(pkg::jvp(vf, x, dir).all_close(try! linalg::matvec(want, dir)));
    let w: Vector<f64> = [0.3, 1.0, -1.0];
    assert(pkg::vjp(vr, x, w).all_close(try! linalg::vecmat(w, want)));
}

#[test]
fn inputs() {
    // Lists, ranges and integer literals read as vectors.
    let g = pkg::grad(|x: Vector<Var>| -> Var { x[0] * x[1] }, [2, 3]);
    assert(g.to_list() == [3.0, 2.0]);
    assert(pkg::grad(|x: Vector<Var>| -> Var { x[0] * x[1] }, 1..3).to_list() == [2.0, 1.0]);
    let xs: List<f64> = [1.0, 4.0];
    assert(pkg::grad(|x: Vector<Dual>| -> Dual { x[1].sqrt() }, xs).to_list() == [0.0, 0.25]);
}

#[test]
fn edge_cases() {
    let e: Vector<f64> = Array::zeros([0]);
    let (v, g) = pkg::value_grad(|x: Vector<Var>| -> Var { Var::constant(5.0) }, e);
    assert(v == 5.0 && g.len() == 0);
    assert(pkg::grad(|x: Vector<Dual>| -> Dual { Dual::constant(1.0) }, e).len() == 0);
    // A constant output: every derivative 0.
    assert(pkg::grad(|x: Vector<Var>| -> Var { Var::constant(2.0) }, [1.0]).to_list() == [0.0]);
    // n not a multiple of the lane count.
    assert(pkg::grad(|x: Vector<Duals<16>>| -> Duals<16> { x[0] * x[2] }, [1.0, 2.0, 3.0]).to_list() == [3.0, 0.0, 1.0]);
    // A NaN propagates.
    assert(pkg::grad(|x: Vector<Var>| -> Var { x[0].ln() }, [-1.0])[0] == -1.0);
    assert(pkg::grad(|x: Vector<Var>| -> Var { x[0].sqrt() }, [-1.0])[0].is_nan());
}
