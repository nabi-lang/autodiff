use pkg::tests::suite::{rand, rosen};
use pkg::{HyperDual, Jet};
use core::array::{Array, Matrix, Vector};

#[test]
fn hessian_rosen() {
    let x: Vector<f64> = [-1.2, 1.0, 0.5];
    let h = pkg::hessian(rosen::<HyperDual>, x);
    // d2/dx_i^2 and the off-diagonal terms of Rosenbrock by hand.
    let want = Matrix::<f64>::from_fn([3, 3], |ix: [usize; 2]| -> f64 {
        let (i, j) = (ix[0], ix[1]);
        if i == j {
            let a = if i + 1 < 3 { 1200.0 * x[i] * x[i] - 400.0 * x[i + 1] + 2.0 } else { 0.0 };
            a + if i > 0 { 200.0 } else { 0.0 }
        } else if j == i + 1 { -400.0 * x[i] } else if i == j + 1 { -400.0 * x[j] } else { 0.0 }
    });
    assert(h.all_close(want, rel: 1e-14), f"{h:?}");
    assert(h.all_close(h.t()));
}

#[test]
fn hessian_random() {
    let x = rand(5, -1.0, 1.0, 7);
    let f = |v: Vector<HyperDual>| -> HyperDual { (v[0] * v[1]).exp() + v[2].sin() * v[3] * v[4] };
    let h = pkg::hessian(f, x);
    let e = (x[0] * x[1]).exp();
    assert(h[0, 1].is_close(e * (1.0 + x[0] * x[1])) && h[0, 0].is_close(e * x[1] * x[1]));
    assert(h[2, 2].is_close(-x[2].sin() * x[3] * x[4]) && h[3, 4].is_close(x[2].sin()) && h[2, 3].is_close(x[2].cos() * x[4]));
    assert(h[0, 4] == 0.0);
}

#[test]
fn taylor() {
    // exp(sin x) at 0: 1, 1, 1, 0, -3, -8 (OEIS A002017).
    let d = pkg::derivatives(|x: Jet| -> Jet { x.sin().exp() }, 0.0, 5);
    assert(d.all_close(Vector::<f64>::from([1.0, 1.0, 1.0, 0.0, -3.0, -8.0]), abs: 1e-13), f"{d:?}");
    // 1 / (1 - x): k! at 0.
    let g = pkg::derivatives(|x: Jet| -> Jet { 1.0 / (1.0 - x) }, 0.0, 6);
    assert(g.to_list() == [1.0, 1.0, 2.0, 6.0, 24.0, 120.0, 720.0]);
    // sqrt, ln, powf, atan, tan, cosh against closed forms at x = 0.5.
    let x = 0.5;
    let s = pkg::derivatives(|x: Jet| -> Jet { x.sqrt() }, x, 3);
    assert(s[3].is_close(3.0 / 8.0 * x.pow(-2.5)));
    let l = pkg::derivatives(|x: Jet| -> Jet { x.ln() }, x, 4);
    assert(l[4].is_close(-6.0 / x.powi(4)));
    let p = pkg::derivatives(|x: Jet| -> Jet { x.powf(2.5) }, x, 3);
    assert(p[3].is_close(2.5 * 1.5 * 0.5 * x.pow(-0.5)));
    let a = pkg::derivatives(|x: Jet| -> Jet { x.atan() }, x, 2);
    assert(a[2].is_close(-2.0 * x / ((1.0 + x * x) * (1.0 + x * x))));
    let t = pkg::derivatives(|x: Jet| -> Jet { x.tan() }, x, 2);
    let sec2 = 1.0 / (x.cos() * x.cos());
    assert(t[2].is_close(2.0 * x.tan() * sec2));
    let c = pkg::derivatives(|x: Jet| -> Jet { x.cosh() * x.powi(-2) }, x, 1);
    assert(c[1].is_close(x.sinh() / (x * x) - 2.0 * x.cosh() / (x * x * x)));
    let q = pkg::derivatives(|x: Jet| -> Jet { x.asin() + x.acos() }, x, 3);
    assert(q[1].abs() < 1e-15 && q[3].abs() < 1e-12);
}

#[test]
fn jet_edges() {
    let x = Jet::var(2.0, 0);
    assert((x.clone() * x).derivatives().to_list() == [4.0]);
    assert(Jet::var(2.0, 3).derivative(7) == 0.0);
    let z = Jet::var(0.0, 3);
    assert(z.abs().derivatives().to_list() == [0.0, 0.0, 0.0, 0.0]);
    assert((Jet::var(1.0, 2) + Jet::var(1.0, 4)).order() == 2);
}
